{
  "$schema": "https://github.com/IBM/audit-ci/raw/main/docs/schema.json",
  // Nightly security gate (see .github/workflows/nightly.yml): fail on
  // high/critical advisories, except the explicitly accepted ones below.
  //
  // Rules for this list:
  // - Only advisories that are unreachable in the SHIPPED app: packages that
  //   run on a developer or CI machine (bundler, CLI, test runner) and never
  //   enter the JS bundle or the WebView assets. Anything that runs on a
  //   user's device, or touches user-supplied files, is fixed instead.
  // - pdfjs-dist is NEVER allowlisted: it parses user-supplied PDFs on device.
  // - Every entry has a reason, an exit plan and an `expiry`. When the expiry
  //   passes the entry stops applying and the nightly fails again, which is
  //   the review reminder: re-check the advisory, then fix or re-date it.
  //
  // Evidence for "build-only" (2026-10-05, Expo SDK 56 / metro 0.84): in
  // package-lock.json each package below is required only by the listed
  // tooling, and an `expo export --platform android --no-minify` bundle of
  // the app contains none of them (no node-forge, micromatch, braces or
  // image-size module; the only string hits were unrelated identifiers).
  "high": true,
  "allowlist": [
    {
      // image-size (all 1.x): infinite loops in the ICNS, JXL and HEIF
      // parsers, i.e. denial of service on a malicious image. Its only
      // dependent is `metro` (^1.0.2) — the bundler's reader for the
      // dimensions of images already in this repo, on a dev/CI machine. Not
      // in the app bundle, so no user-supplied image ever reaches it; the
      // worst case is a hung build.
      //
      // No fix to take: every 1.x is affected, image-size 2.x is not
      // API-compatible with metro's caller, and npm's "fix" is a
      // react-native DOWNGRADE to 0.72 (breaks the SDK 56 pin and the app).
      //
      // Exit plan: drop both image-size entries when an Expo SDK bump brings
      // a metro on a patched image-size. Re-check on every SDK upgrade.
      "GHSA-w3rx-r6r6-pgpr": {
        "active": true,
        "expiry": "2027-01-05",
        "notes": "image-size ICNS DoS; build-only (metro asset sizing). Exit: SDK bump with patched metro.",
      },
    },
    {
      "GHSA-5p2g-fcmc-qvqq": {
        "active": true,
        "expiry": "2027-01-05",
        "notes": "image-size JXL/HEIF DoS; build-only (metro asset sizing). Exit: SDK bump with patched metro.",
      },
    },
    {
      // braces <=3.0.3 (latest; no patched release exists): stack exhaustion
      // on a deeply nested glob pattern. Its only dependent is micromatch,
      // whose only dependents are metro-file-map, @expo/metro-file-map (the
      // bundler's file watcher/crawler) and jest. The patterns it expands
      // come from our own metro/jest config, not from users, and none of
      // these packages is in the app bundle. Worst case: a crashed build.
      //
      // Exit plan: drop when braces publishes a fix (micromatch ^4.0.8 takes
      // any 3.x via `^3.0.3`, so a lockfile refresh picks it up), or when an
      // SDK bump moves metro off micromatch.
      "GHSA-vfj7-8cjw-p6xm": {
        "active": true,
        "expiry": "2027-01-05",
        "notes": "braces glob-expansion DoS; build-only (metro-file-map, jest via micromatch). Exit: braces fix or SDK bump.",
      },
    },
    {
      // node-forge <=1.4.0 (latest; no patched release exists): RSA PKCS#1
      // v1.5 signature verification accepts extra nested DigestAlgorithm
      // elements (signature forgery). Required only by @expo/cli and
      // @expo/code-signing-certificates. The latter is pulled in by
      // expo-updates for its Node CLI scripts (expo-updates/cli:
      // generate/configure code signing), not by its runtime: expo-updates'
      // JS build never imports it, and on-device update verification is
      // native (Swift/Kotlin). We do not use EAS Update code signing at all
      // (no `codeSigningCertificate` in app.config.ts), so nothing in the
      // shipped app verifies a signature with node-forge.
      //
      // Exit plan: drop when node-forge publishes a fix (both dependents use
      // `^1.3.3`, so a lockfile refresh picks it up). If we ever turn on
      // update code signing, re-evaluate before then: the signing scripts
      // would then run in our release pipeline.
      "GHSA-86w9-cpqp-85rv": {
        "active": true,
        "expiry": "2027-01-05",
        "notes": "node-forge RSA sig forgery; build-only (@expo/cli, expo-updates CLI code-signing scripts; no code signing configured). Exit: node-forge fix.",
      },
    },
  ],
}

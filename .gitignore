# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/

# test coverage
coverage/

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Store credentials & signed artifacts — never commit
google-service-account.json
asc-api-key.p8
*.aab
*.apk

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android
builds/
# local EAS build logs (build-vc<N>.log)
build-vc*.log

# local secret material — never commit
.expo-token.local

# Subagent-driven-development scratch
.superpowers/

# Catalog generator: bulk-index fragments (scripts/catalog/fragments/).
# Rule — check in a fragment only when regenerating it is slow or fragile
# (nrcan-cantopo.json is 128 crawled directory listings + HEAD requests, so it
# stays). Fragments rebuilt from a single published bulk index are cheap to
# redo (`npx tsx scripts/catalog/fetch-ustopo.ts`, ~20 s) and would otherwise
# duplicate every byte of docs/catalog/v2/shards/ a second time in git.
scripts/catalog/fragments/usgs-ustopo.json

# Catalog generator: resumable HEAD cache for the CanTopo crawl.
scripts/catalog/.cache/
